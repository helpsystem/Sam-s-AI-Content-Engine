# ==============================================================================
# Postiz Orchestrator Environment Configuration
# Copy this file to .env.postiz and fill in your secrets
# ==============================================================================

# Database credentials (internal to Docker)
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=ChangeThisSecretPostizDbPassword2026!
POSTIZ_DB_NAME=postiz_db

# Redis authentication (internal to Docker)
POSTIZ_REDIS_PASSWORD=ChangeThisSecretRedisPassword2026!

# Port exposed on host (default: 5000)
POSTIZ_HOST_PORT=5000

# Public or Local URL for Postiz instance
POSTIZ_PUBLIC_URL=http://localhost:5000

# Strong random 32+ character JWT Secret
POSTIZ_JWT_SECRET=super-secret-jwt-key-minimum-32-chars-length-here

# Optional: Social network app keys (if you want Postiz to handle direct OAuth)
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_API_KEY=
# X_API_SECRET=
